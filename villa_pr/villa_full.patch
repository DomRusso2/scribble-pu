+        alpha=float(term_cfg.get("alpha", 7.0)),
+        rho=float(term_cfg.get("rho", 0.96)),
+        y_lo=float(term_cfg.get("y_lo", 0.25)),
+        y_hi=float(term_cfg.get("y_hi", 0.82)),
+        w_blank=float(term_cfg.get("w_blank", 1.0 / 6.0)),
+        min_pos_px=int(term_cfg.get("min_pos_px", 30)),
+        min_unlabeled_px=int(term_cfg.get("min_unlabeled_px", 50)),
+        pi_u_cap=float(term_cfg.get("pi_u_cap", 0.55)),
+        pi_tot_cap=float(term_cfg.get("pi_tot_cap", 0.65)),
+        batch_neg_risk=bool(term_cfg.get("batch_neg_risk", True)),
+    )
+
+
 LOSS_TERM_BUILDERS = {
     "LabelSmoothedDCAndBCELoss": _build_label_smoothed_dice_bce_term,
     "BettiMatchingLoss": _build_betti_matching_term,
